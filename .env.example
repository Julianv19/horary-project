# === Configuración de la aplicación ===
# Copia este archivo como .env y ajusta los valores. El archivo .env NO se versiona.

# Puerto del servidor web
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Ruta del archivo de base de datos SQLite
DB_PATH=./db/horary.sqlite

# Secreto para sesiones (cámbialo por un valor aleatorio largo)
SESSION_SECRET=cambia-esto-por-un-secreto-aleatorio
