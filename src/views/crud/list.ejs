<%- include('../partials/header') %>

<section class="hero">
  <h1><%= plural %></h1>
  <a class="btn" href="<%= basePath %>/nuevo">+ Nuevo</a>
</section>

<% if (flash && flash.ok) { %>
  <div class="alert ok"><%= flash.ok %></div>
<% } %>
<% if (flash && flash.err) { %>
  <div class="alert err"><%= flash.err %></div>
<% } %>

<% if (items.length === 0) { %>
  <p class="muted">No hay registros todavía. Crea el primero con “+ Nuevo”.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <% columns.forEach(c => { %><th><%= c.label %></th><% }) %>
        <th class="acciones">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(item => { %>
        <tr>
          <% columns.forEach(c => { %>
            <td>
              <% const val = item[c.key]; %>
              <% if (c.type === 'bool') { %>
                <span class="pill <%= val ? 'yes' : 'no' %>"><%= val ? 'Sí' : 'No' %></span>
              <% } else if (c.type === 'color') { %>
                <span class="swatch" style="background: <%= val %>"></span> <%= val %>
              <% } else if (c.type === 'estado') { %>
                <% const est = { DISPONIBLE:['est-disp','Disponible'], DESCANSO:['est-desc','Descansando'], INCAPACIDAD:['est-inc','Incapacidad'], VACACIONES:['est-vac','Vacaciones'], INDUCCION:['est-ind','Inducción'], AUSENTE:['est-aus','Ausente'], INACTIVO:['est-off','Inactivo'] }[val] || ['est-disp', val]; %>
                <span class="estado-badge <%= est[0] %>"><%= est[1] %></span>
              <% } else { %>
                <%= (val === null || val === undefined || val === '') ? '—' : val %>
              <% } %>
            </td>
          <% }) %>
          <td class="acciones">
            <a class="link" href="<%= basePath %>/<%= item.id %>/editar">Editar</a>
            <form method="post" action="<%= basePath %>/<%= item.id %>/eliminar"
                  onsubmit="return confirm('¿Eliminar este registro? Esta acción no se puede deshacer.');">
              <%- include('../partials/csrf') %>
              <button type="submit" class="link danger">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
