<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %><%= appName %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header class="topbar">
    <div class="brand">🍗 <strong>Horary</strong><span>Project</span></div>
    <nav>
      <% (typeof menu !== 'undefined' ? menu : []).forEach(m => { %>
        <% const act = m.basePath === '/' ? currentPath === '/' : currentPath.startsWith(m.basePath); %>
        <a href="<%= m.basePath %>" class="<%= act ? 'active' : '' %>"><%= m.label %></a>
      <% }) %>
    </nav>
  </header>
  <main class="container">
