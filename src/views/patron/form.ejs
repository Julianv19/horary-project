<%- include('../partials/header') %>

<section class="hero"><h1><%= titulo %></h1></section>

<% if (typeof flash !== 'undefined' && flash && flash.ok) { %><div class="alert ok"><%= flash.ok %></div><% } %>
<% if (typeof flash !== 'undefined' && flash && flash.err) { %><div class="alert err"><%= flash.err %></div><% } %>
<% if (error) { %><div class="alert err"><strong>No se pudo guardar:</strong> <%= error %></div><% } %>

<form method="post" action="<%= esNuevo ? '/patrones' : '/patrones/' + patron.id %>" class="form-card">
  <%- include('../partials/csrf') %>
  <div class="field">
    <label for="nombre">Nombre <span class="req">*</span></label>
    <input type="text" name="nombre" id="nombre" value="<%= patron.nombre || '' %>" required>
  </div>
  <div class="field">
    <label for="rutina">Rutina</label>
    <select name="rutina" id="rutina">
      <option value="">—</option>
      <% RUTINAS.forEach(r => { %>
        <option value="<%= r %>" <%= patron.rutina === r ? 'selected' : '' %>><%= r %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="descripcion">Descripción</label>
    <textarea name="descripcion" id="descripcion" rows="2"><%= patron.descripcion || '' %></textarea>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn">Guardar</button>
    <a class="btn ghost" href="/patrones">Volver</a>
  </div>
</form>

<% if (!esNuevo) { %>
  <h2>Turnos del patrón</h2>
  <p class="muted">Agrega uno o varios bloques por día. Dos o más bloques en un día = turno partido.</p>

  <form method="post" action="/patrones/<%= patron.id %>/turnos" class="form-card inline">
    <%- include('../partials/csrf') %>
    <div class="field">
      <label for="dia_semana">Día</label>
      <select name="dia_semana" id="dia_semana">
        <% DIAS.forEach((d, i) => { %><option value="<%= i %>"><%= d %></option><% }) %>
      </select>
    </div>
    <div class="field">
      <label for="hora_inicio">Inicio</label>
      <input type="time" name="hora_inicio" id="hora_inicio" required>
    </div>
    <div class="field">
      <label for="hora_fin">Fin</label>
      <input type="time" name="hora_fin" id="hora_fin" required>
    </div>
    <div class="form-actions"><button type="submit" class="btn">+ Agregar turno</button></div>
  </form>

  <div class="area-block">
    <% DIAS.forEach((d, i) => { const bloques = turnosPorDia[i] || []; %>
      <div class="rol-row">
        <span class="area-title" style="border:none;margin:0;"><%= d %></span>
        <span></span>
        <div>
          <% if (bloques.length === 0) { %>
            <span class="muted">—</span>
          <% } else { %>
            <% bloques.forEach(b => { %>
              <span class="turno-chip">
                <%= b.hora_inicio %>–<%= b.hora_fin %>
                <form method="post" action="/patrones/<%= patron.id %>/turnos/<%= b.id %>/eliminar" style="display:inline">
                  <%- include('../partials/csrf') %>
                  <button class="link danger x" type="submit" title="Quitar">✕</button>
                </form>
              </span>
            <% }) %>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
