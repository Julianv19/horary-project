<%- include('../partials/header') %>

<section class="hero">
  <h1>Patrones de turnos</h1>
  <a class="btn" href="/patrones/nuevo">+ Nuevo patrón</a>
</section>
<p class="muted">Plantillas de turnos por día (soportan turnos partidos). Se asignan a un
colaborador desde su ficha y el motor de aforo las sigue al generar.</p>

<% if (flash && flash.ok) { %><div class="alert ok"><%= flash.ok %></div><% } %>
<% if (flash && flash.err) { %><div class="alert err"><%= flash.err %></div><% } %>

<% if (patrones.length === 0) { %>
  <p class="muted">No hay patrones todavía.</p>
<% } else { %>
  <table>
    <thead><tr><th>Nombre</th><th>Rutina</th><th>Días</th><th>Turnos</th><th class="acciones">Acciones</th></tr></thead>
    <tbody>
      <% patrones.forEach(p => { %>
        <tr>
          <td><strong><%= p.nombre %></strong></td>
          <td><%= p.rutina || '—' %></td>
          <td><%= p.dias %></td>
          <td><%= p.turnos %></td>
          <td class="acciones">
            <a class="link" href="/patrones/<%= p.id %>/editar">Editar</a>
            <form method="post" action="/patrones/<%= p.id %>/eliminar"
                  onsubmit="return confirm('¿Eliminar el patrón? Los colaboradores quedarán sin patrón.');">
              <button class="link danger" type="submit">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
