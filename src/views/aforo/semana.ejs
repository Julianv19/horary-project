<%- include('../partials/header') %>

<section class="hero">
  <h1>Horario semanal</h1>
</section>

<form method="get" action="/aforo/ver" class="toolbar">
  <label>Sede:
    <select name="sede" onchange="this.form.submit()">
      <% sedes.forEach(s => { %>
        <option value="<%= s.id %>" <%= s.id === sedeId ? 'selected' : '' %>><%= s.nombre %></option>
      <% }) %>
    </select>
  </label>
  <label>Semana: <input type="date" name="semana" value="<%= semana %>" onchange="this.form.submit()"></label>
  <a class="btn ghost" href="/aforo?sede=<%= sedeId %>&semana=<%= semana %>">⚙ Volver a generar</a>
  <% if (data) { %>
    <a class="btn ghost no-print" href="/aforo/export.csv?sede=<%= sedeId %>&semana=<%= semana %>">⬇ Exportar CSV</a>
    <button type="button" class="btn ghost no-print" onclick="window.print()">🖨 Imprimir / PDF</button>
  <% } %>
</form>

<% if (flash && flash.ok) { %><div class="alert ok"><%= flash.ok %></div><% } %>
<% if (flash && flash.err) { %><div class="alert err"><%= flash.err %></div><% } %>

<% if (!data) { %>
  <div class="alert err">No hay horario generado para <strong><%= sede ? sede.nombre : 'esta sede' %></strong>
    en la semana del <strong><%= semana %></strong>.</div>
  <p><a class="btn" href="/aforo?sede=<%= sedeId %>&semana=<%= semana %>">Generar ahora</a></p>
<% } else { %>

  <p class="muted">Sede <strong><%= sede.nombre %></strong> · semana del <strong><%= semana %></strong>
    (<%= fechas[0] %> → <%= fechas[6] %>).</p>

  <div class="publish-bar no-print">
    Estado:
    <span class="pill <%= data.programacion.estado === 'PUBLICADA' ? 'yes' : 'no' %>"><%= data.programacion.estado %></span>
    <form method="post" action="/aforo/publicar" style="display:inline">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="sede_id" value="<%= sedeId %>">
      <input type="hidden" name="semana" value="<%= semana %>">
      <% if (data.programacion.estado === 'PUBLICADA') { %>
        <input type="hidden" name="estado" value="BORRADOR">
        <button class="btn ghost" type="submit">Volver a borrador</button>
      <% } else { %>
        <input type="hidden" name="estado" value="PUBLICADA">
        <button class="btn" type="submit">✅ Publicar</button>
      <% } %>
    </form>
    <% if (data.programacion.estado === 'PUBLICADA') { %>
      <span class="muted"><small>Publicado: visible para los colaboradores y bloqueado para regenerar.</small></span>
    <% } %>
  </div>

  <!-- ===== Validación de reglas ===== -->
  <% if (validacion) {
       const oblig = validacion.conflictos.filter(c => c.severidad === 'obligatoria');
       const sug = validacion.conflictos.filter(c => c.severidad === 'sugerencia'); %>
    <% if (oblig.length) { %>
      <div class="alert err validacion">
        <strong>⛔ <%= oblig.length %> conflicto(s) obligatorio(s)</strong> — no se puede publicar hasta corregirlos:
        <ul>
          <% oblig.forEach(cf => { %><li><strong><%= cf.colaborador %></strong> — <%= cf.turno %>: <%= cf.motivo %></li><% }) %>
        </ul>
      </div>
    <% } %>
    <% if (sug.length) { %>
      <div class="alert warn validacion">
        <strong>⚠️ <%= sug.length %> aviso(s) de sugerencias</strong> (no bloquean la publicación):
        <ul>
          <% sug.forEach(cf => { %><li><strong><%= cf.colaborador %></strong> — <%= cf.turno %>: <%= cf.motivo %></li><% }) %>
        </ul>
      </div>
    <% } %>
    <% if (!oblig.length && !sug.length) { %>
      <div class="alert ok validacion">✅ Sin conflictos con restricciones, regla administrativa ni sugerencias.</div>
    <% } %>
  <% } %>

  <!-- ===== Resumen de horas por colaborador ===== -->
  <h2>Horas por colaborador</h2>
  <div class="scroll-x">
    <table class="grid">
      <thead>
        <tr>
          <th class="sticky">Colaborador</th>
          <th>Rol</th><th>Jorn.</th>
          <% ['L','M','X','J','V','S','D'].forEach(d => { %><th><%= d %></th><% }) %>
          <th>Sem.</th><th>Estado</th>
        </tr>
      </thead>
      <tbody>
        <% data.colaboradores.forEach(c => { %>
          <tr>
            <td class="sticky"><%= c.nombre %></td>
            <td><span class="rol-chip sm" style="background: <%= c.color || '#ccc' %>"><%= c.rol %></span></td>
            <td><%= c.jornada_codigo %></td>
            <% c.dias.forEach(d => { %>
              <td class="num">
                <% if (d.trabaja) { %>
                  <span title="<%= (d.segmentos || []).join(' / ') %>"><%= d.horas %><% if ((d.segmentos||[]).length > 1) { %><sup>*</sup><% } %></span>
                <% } else if (d.ausencia) { %>
                  <span class="aus" title="<%= d.ausencia %>"><%= d.ausencia.slice(0, 3) %></span>
                <% } else { %>
                  <span class="muted">D</span>
                <% } %>
              </td>
            <% }) %>
            <td class="num"><strong><%= c.horasSemana %></strong></td>
            <td>
              <% const et = {ok:['okc','OK'], bajo:['over','Bajo'], alto:['gap','Alto']}[c.estadoJornada] || ['','—']; %>
              <span class="pill cell <%= et[0] %>"><%= et[1] %></span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="muted"><small>“D” = descanso. Estado compara las horas de la semana con el rango de la jornada
    (TC debe cumplir 7 h exactas/día).</small></p>

  <!-- ===== Detalle por colaborador y hora ===== -->
  <h2>Horario por colaborador y franja</h2>
  <% function claseCob(asg, req) {
       if (req === 0 && asg === 0) return '';
       if (asg < req) return 'gap';
       if (asg > req) return 'over';
       return 'okc';
     } %>
  <% data.porDia.forEach(dd => { %>
    <h3 class="area-title"><%= dd.nombre %> <%= dd.fecha %>
      <% if (dd.abierto) { %><small class="muted">· <%= dd.apertura %>–<%= dd.cierre %></small>
      <% } else { %><small class="muted">· Cerrado</small><% } %>
    </h3>
    <% if (dd.abierto) { %>
      <div class="scroll-x">
        <table class="grid detalle">
          <thead>
            <tr>
              <th class="sticky">Colaborador</th>
              <th>Jorn.</th>
              <% dd.horas.forEach(h => { %><th><%= h %></th><% }) %>
              <th>T.H</th>
            </tr>
          </thead>
          <tbody>
            <% dd.grupos.forEach(g => { %>
              <tr class="area-head">
                <td class="sticky" colspan="2"><%= g.area %></td>
                <% g.personasPorHora.forEach((a, i) => { %><td class="num"><%= a || '' %></td><% }) %>
                <td></td>
              </tr>
              <% g.filas.forEach(f => { %>
                <tr>
                  <td class="sticky" title="<%= f.rol %>"><%= f.nombre %></td>
                  <td><%= f.jornada %></td>
                  <% f.marcas.forEach((m, i) => { %>
                    <% if (m) { %>
                      <td class="on" style="background: <%= f.color || '#9bb38a' %>" title="<%= (f.segmentos||[]).join(' / ') %>"></td>
                    <% } else { %>
                      <td></td>
                    <% } %>
                  <% }) %>
                  <td class="num"><strong><%= f.horas %></strong></td>
                </tr>
              <% }) %>
              <tr class="subtotal">
                <td class="sticky" colspan="2">Total <%= g.area %> (asignado/requerido)</td>
                <% g.personasPorHora.forEach((a, i) => { const req = g.requerido[i]; %>
                  <td class="cell <%= claseCob(a, req) %>"><%= a %>/<%= req %></td>
                <% }) %>
                <td></td>
              </tr>
            <% }) %>
            <tr class="total">
              <td class="sticky" colspan="2">No. personas por hora</td>
              <% dd.totalAsignado.forEach((a, i) => { %>
                <td class="cell <%= claseCob(a, dd.totalRequerido[i]) %>"><%= a %>/<%= dd.totalRequerido[i] %></td>
              <% }) %>
              <td></td>
            </tr>
          </tbody>
        </table>
      </div>
      <% if (dd.descansan && dd.descansan.length) { %>
        <p class="muted descansan"><small><strong>Descansan / ausentes:</strong>
          <% dd.descansan.forEach((d, i) => { %><%= d.nombre %> (<%= d.nota %>)<%= i < dd.descansan.length - 1 ? ' · ' : '' %><% }) %>
        </small></p>
      <% } %>
    <% } %>
  <% }) %>

  <p class="muted"><small>
    Cada celda coloreada = una hora cubierta por ese colaborador (pasa el cursor para ver el turno).
    En los totales: <span class="chip gap"></span> hueco · <span class="chip over"></span> sobrecupo ·
    <span class="chip okc"></span> cubierto.
  </small></p>
<% } %>

<%- include('../partials/footer') %>
