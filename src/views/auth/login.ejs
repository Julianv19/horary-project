<%- include('../partials/header') %>

<div class="login-wrap">
  <form method="post" action="/login" class="form-card login-card">
    <%- include('../partials/csrf') %>
    <div class="login-brand">🍗 <strong>FRISBY</strong></div>
    <p class="login-sub">Gestión de horarios</p>
    <% if (error) { %><div class="alert err"><%= error %></div><% } %>
    <div class="field">
      <label for="username">Usuario</label>
      <input type="text" name="username" id="username" autofocus required>
    </div>
    <div class="field">
      <label for="password">Contraseña</label>
      <input type="password" name="password" id="password" required>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn">Entrar</button>
    </div>
    <p class="muted"><small>Admin de ejemplo: <code>admin</code> / <code>admin123</code>.</small></p>
  </form>
</div>

<%- include('../partials/footer') %>
